# Скопируйте в .env и впишите свои ключи. .env в git не коммитить.
#
# Два пути на выбор, можно смешивать.
#
# 1) Прямые ключи провайдеров -- дешевле, но заводить надо каждый отдельно.
#    Имена моделей: anthropic/claude-opus-4-5, gemini/gemini-2.5-pro, openai/gpt-5, ...
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=

# 2) OpenRouter -- один ключ на всех, включая Grok и Qwen.
#    Имена моделей: openrouter/anthropic/claude-opus-4.5, openrouter/x-ai/grok-4, ...
OPENROUTER_API_KEY=


# --- Настоящая Raspberry Pi (необязательно) --------------------------------
#
# Если RE_PI_HOST пуст, модель о Pi даже не узнает и работает только с эмуляцией.
# Проверить связь: python agent.py --check-pi
#
# ВНИМАНИЕ. Это даёт модели право запускать анализируемый код на живом железе,
# в вашей сети. Считайте Pi одноразовой: отдельный сегмент сети, SD-карта под
# перезалив, пароли, которые больше нигде не используются. После сеанса с
# недоверенным образцом машину следует считать скомпрометированной.
#
# Учётные данные остаются на хосте: в контейнер они не попадают, сети у него нет.
RE_PI_HOST=
RE_PI_PORT=22
RE_PI_USER=pi
# Аутентификация: либо пароль, либо путь к приватному ключу (ключ надёжнее).
RE_PI_PASSWORD=
RE_PI_KEY=
# Рабочий каталог на Pi. По умолчанию /tmp/re-<метка запуска>.
RE_PI_WORKDIR=
